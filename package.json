{
  "name": "meetingscribe",
  "version": "1.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "dev:desktop": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\" \"ELECTRON_DEV=true electron .\"",
    "electron:start": "electron .",
    "start": "node server/src/index.js",
    "test": "NODE_ENV=test node --test server/tests/*.test.js client/src/tests/*.test.js",
    "build:desktop": "npm run build --prefix client && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1"
  },
  "build": {
    "appId": "com.meetingscribe.app",
    "productName": "MeetingScribe",
    "icon": "icon.png",
    "npmRebuild": true,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/@xenova/**/*",
      "**/*.node",
      "server/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "extendInfo": {
        "CFBundleName": "MeetingScribe",
        "CFBundleDisplayName": "MeetingScribe",
        "NSMicrophoneUsageDescription": "MeetingScribe membutuhkan akses mikrofon untuk merekam audio meeting.",
        "NSScreenCaptureUsageDescription": "MeetingScribe membutuhkan akses audio sistem untuk merekam suara meeting online."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "icon.png"
    },
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "iconTemplate.png",
      "server/**/*",
      "client/dist/**/*"
    ]
  }
}
